MYSQL_DATABASE=museum
MYSQL_USER=museum_app
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MUSEUM_JWT_SECRET=replace-with-a-random-32-character-or-longer-local-secret
MUSEUM_BOOTSTRAP_ENABLED=true
MUSEUM_BOOTSTRAP_ADMIN_USERNAME=admin
MUSEUM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
MUSEUM_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
MUSEUM_MAIL_WEB_PORT=8025
MUSEUM_MAIL_FROM=no-reply@heluo.local
# SMTP is off by default. For local test mail only: enable the dev-mail profile and set
# MUSEUM_SMTP_HOST=mailpit
# MUSEUM_SMTP_PORT=1025
# For a public deployment use an approved SMTP service instead:
# MUSEUM_SMTP_HOST=smtp.example.test
# MUSEUM_SMTP_PORT=587
# MUSEUM_SMTP_USERNAME=...
# MUSEUM_SMTP_PASSWORD=...
# MUSEUM_SMTP_AUTH=true
# MUSEUM_SMTP_STARTTLS=true
# Public HTTP(S) origin, without a path/query/credentials; used by email and live sitemap/robots.
# MUSEUM_PUBLIC_BASE_URL=https://museum.example.test
# MUSEUM_SPA_INDEX_URL is injected by Compose for its internal frontend service; PocketBay uses the bundled index.
# Only override these if the default network conflicts or there is an additional trusted proxy.
# MUSEUM_NETWORK_SUBNET=172.30.88.0/24
# MUSEUM_NGINX_IP=172.30.88.10
# MUSEUM_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.30.88.10/32
# Luosheng AI Guide v2 switches (ADR-010). Keep API keys in a protected runtime environment.
# Frontend single switch (build arg):
# VITE_GUIDE_ENABLED=false
# Backend runtime switches:
# MUSEUM_GUIDE_ENABLED=false
# MUSEUM_GUIDE_MODEL_ENABLED=true
# MUSEUM_GUIDE_MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
# MUSEUM_GUIDE_MODEL_NAME=deepseek-chat
# MUSEUM_GUIDE_MODEL_KEY=
# MUSEUM_GUIDE_PACK_PATH=
# MUSEUM_GUIDE_MINIMUM_VERSION_PATH=
# MUSEUM_GUIDE_APPROVED_DIGEST_PATH=
# MUSEUM_GUIDE_DAILY_TURN_LIMIT=200
# MUSEUM_GUIDE_MAX_CONCURRENT_GENERATIONS=4
# MUSEUM_GUIDE_RATE_LIMIT_PER_MINUTE=12
# MUSEUM_GUIDE_PAUSE_PATH=
