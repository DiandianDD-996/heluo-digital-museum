# Development/preview proxy only; production uses the same-origin reverse proxy.
MUSEUM_DEV_API_URL=http://localhost:8080
# Enable the preset guide in a controlled build with the corresponding backend endpoint.
# VITE_GUIDE_PRESET_ENABLED=false
# VITE_GUIDE_SITE_ENABLED=false
# Controlled signed-content candidate only. Requires VITE_GUIDE_SITE_ENABLED and the same-origin turns API.
# VITE_GUIDE_TURNS_ENABLED=false
# Loopback Vite development only. Set to http (synthetic) or model (configured preview adapter).
# VITE_GUIDE_UNIFIED_PREVIEW=
